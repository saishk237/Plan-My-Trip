# Docker Environment Variables Example
# Copy this file to .env for Docker Compose

# Database Configuration
POSTGRES_PASSWORD=your-secure-postgres-password

# Application Configuration
NODE_ENV=production
PORT=5000

# Database URL (automatically constructed in docker-compose.yml)
# DATABASE_URL=postgresql://postgres:your-password@postgres:5432/planmytrip

# API Keys (at least one required)
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# AI Provider Selection (optional, defaults to "auto")
# Options: "groq", "gemini", "auto"
# "auto" will try all configured providers with automatic failover
AI_PROVIDER=auto

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Optional: Custom Database Configuration
# POSTGRES_USER=postgres
# POSTGRES_DB=planmytrip





